# ===== 基本設定 =====
PORT=3000
PUBLIC_BASE_URL=https://hostoneai.aitem-inc.co.jp
DOMAIN=hostoneai.aitem-inc.co.jp
ACME_EMAIL=admin@aitem-inc.co.jp
DATABASE_PATH=./data/hostone.db

# 管理画面ログイン(必ず変更してください)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# ===== AI (Claude API) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low / medium / high  (電話は応答速度優先で low 推奨)
AI_EFFORT=low
# サーバー側フォールバック (on/off)
AI_FALLBACKS=on

# ===== Beds24 (API v2) =====
# Beds24 管理画面 > Settings > Apps & Integrations > API で招待コードを発行し、
# POST /authentication/setup で取得した refreshToken を設定
BEDS24_REFRESH_TOKEN=
BEDS24_POLL_SECONDS=60

# ===== LINE Messaging API =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== Slack =====
# スタッフ通知・承認用チャンネル
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_NOTIFY_CHANNEL=
# (任意) Bot Token を使わず Incoming Webhook だけで通知する場合
SLACK_WEBHOOK_URL=

# ===== 電話 (Twilio Voice) =====
TWILIO_AUTH_TOKEN=
# AIで解決できない時に転送するスタッフの電話番号 (E.164形式 例: +819012345678)
HOST_PHONE_NUMBER=

# ===== お問い合わせメール (LP のフォーム) =====
# 送信先。LP のフォームはここへ届く
CONTACT_TO=info@joeai.co.jp
# SMTP。joeai.co.jp (WordPress) と同じ Xserver のものを使う
SMTP_HOST=sv14898.xserver.jp
SMTP_PORT=465
# ssl(465) / tls(587)
SMTP_SECURE=ssl
SMTP_USER=info@joeai.co.jp
# ↓ ご本人が記入してください（この値はこちらでは扱いません）
SMTP_PASS=
SMTP_FROM=info@joeai.co.jp
SMTP_FROM_NAME=HostOne AI
